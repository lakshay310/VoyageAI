# ============================================================
# VoyageAI Backend Environment Configuration Example
# Copy this file to .env and fill in your credentials
# ============================================================

# Server Port and Environment
PORT=5000
NODE_ENV=development

# Database Connection (PostgreSQL / Neon)
DATABASE_URL="postgresql://username:password@ep-sample-123456.ap-southeast-1.aws.neon.tech/neondb?sslmode=require"

# JWT Authentication
JWT_SECRET=supersecret_jwt_key_voyageai_2026
JWT_EXPIRES_IN=7d

# CORS Allowed Origin (Frontend URL)
CLIENT_URL=http://localhost:5173

# Google Gemini AI API Key (for AI Trip Planner)
GEMINI_API_KEY=your_gemini_api_key_here

# Cloudinary (for avatar and trip image uploads)
CLOUDINARY_CLOUD_NAME=your_cloud_name
CLOUDINARY_API_KEY=your_cloudinary_api_key
CLOUDINARY_API_SECRET=your_cloudinary_api_secret
